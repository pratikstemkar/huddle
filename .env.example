# Copy to .env.local (git-ignored) and restart Expo after changes.

# Local Supabase: run `npm run db:start`, then copy the API URL and the "Publishable" key from its output.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Developer sign-in (skips Google/Apple). Only works in dev builds (__DEV__), never in production.
EXPO_PUBLIC_DEV_AUTH=true
EXPO_PUBLIC_DEV_PASSWORD=trip-dev-password
